#!/bin/bash
# xdr：沙箱里操作受管主机与平台数据的唯一方式。经 unix socket 交给沙箱桥，再由平台判权、审批、审计；
# 沙箱本身不持有平台凭据，也访问不到平台网络。这里只做参数整理与输出格式化。
set -euo pipefail
SOCKET=${XDR_SOCKET:-/tmp/xdr/xdr.sock}
CONTEXT=${XDR_CONTEXT:-/tmp/xdr/context.json}

call() { # 工具名 参数JSON
  local resp
  resp=$(curl -sS --max-time 1800 --unix-socket "$SOCKET" -H 'Content-Type: application/json' \
    -d "$(jq -cn --arg n "$1" --argjson a "$2" '{name:$n,args:$a}')" http://xdr/tool) || { echo "xdr 通道不可用" >&2; exit 2; }
  if jq -e 'has("error")' >/dev/null <<<"$resp"; then jq -r .error <<<"$resp" >&2; exit 1; fi
  jq -r .output <<<"$resp"
}

context() { cat "$CONTEXT"; }

host_id() { # 主机名或资产 ID
  if [[ $1 =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then echo "$1"; return; fi
  local id; id=$(context | jq -r --arg h "$1" '.assets[] | select(.hostname==$h) | .id' | head -1)
  [ -n "$id" ] || { echo "本组没有主机 $1，用 xdr hosts 查看" >&2; exit 1; }
  echo "$id"
}

usage() {
  cat <<'U'
用法：
  xdr hosts                              本组主机（主机名、角色、重要程度、区域）
  xdr context                            平台给的组内数据：资产、规则名、待办、交来的事件（JSON）
  xdr exec <主机名> <命令> [超时秒]       在主机上执行命令（高风险命令会等管理员批准）
  xdr sql <只读SQL>                      查本组只读视图，输出 TSV（首行列名）
  xdr track <主机名> <key> <low|medium|high> <open|resolved|withdrawn> <标题> <详情>
  xdr identify <主机名> <tcp/端口|udp/端口> <high|medium|low> <服务名> <依据与结论>
  xdr egress <主机名> <公网地址> <high|medium|low> <用途> <依据与结论>
  xdr memories                           本组长期记忆（实时，含本轮刚记下的；id、来源、主机、内容）
  xdr remember [主机名|-] <内容>          记下以后用得上的环境事实（- 表示整个组）
  xdr forget <记忆 id>                   删掉过时的 AI 记忆
  xdr suppress <主机名> <规则 id> <理由> <天数> <条件>...
                                         提议抑制反复误报的命中（组管理员批准后生效）。条件 1–3 个，AND：
                                         字段=值（等于）、字段~=值（包含）、字段$=值（结尾），字段为事件体 dot path
  xdr report <标题> <Markdown 文件>       保存最终报告
U
}

cmd=${1:-}; shift || true
case "$cmd" in
  hosts) context | jq -r '.assets[] | [.hostname, (.role // "-"), (.criticality // "-" | tostring), (.zone.name // .zone.kind), (.os // "-")] | @tsv' | column -t -s $'\t' ;;
  context) context | jq . ;;
  exec)
    [ $# -ge 2 ] || { usage; exit 2; }
    out=$(call exec "$(jq -cn --arg h "$(host_id "$1")" --arg c "$2" --argjson t "${3:-60}" '{host:$h,cmd:$c,timeout:$t}')")
    jq -r '"[status=\(.status) exit=\(.exit_code // "-")\(if .truncated then " truncated" else "" end)]", (.stdout // ""), (if (.stderr // "") != "" then "[stderr]\n" + .stderr else empty end)' <<<"$out" ;;
  sql)
    [ $# -ge 1 ] || { usage; exit 2; }
    out=$(call query "$(jq -cn --arg s "$1" '{sql:$s}')")
    jq -r '(.columns | @tsv), (.rows[] | map(if type == "object" or type == "array" then tojson else (. // "" | tostring) end) | @tsv), (if .truncated then "[truncated]" else empty end)' <<<"$out" ;;
  track)
    [ $# -ge 6 ] || { usage; exit 2; }
    call track "$(jq -cn --arg h "$(host_id "$1")" --arg k "$2" --arg sv "$3" --arg st "$4" --arg t "$5" --arg d "$6" '{host:$h,key:$k,severity:$sv,status:$st,title:$t,detail:$d}')" ;;
  identify)
    [ $# -ge 5 ] || { usage; exit 2; }
    call identify "$(jq -cn --arg h "$(host_id "$1")" --arg p "$2" --arg r "$3" --arg n "$4" --arg note "$5" '{host:$h,port:$p,risk:$r,name:$n,note:$note}')" ;;
  egress)
    [ $# -ge 5 ] || { usage; exit 2; }
    call egress "$(jq -cn --arg h "$(host_id "$1")" --arg ip "$2" --arg r "$3" --arg n "$4" --arg note "$5" '{host:$h,ip:$ip,risk:$r,name:$n,note:$note}')" ;;
  memories) call memories '{}' | jq -r '.memories[] | [.id, .source, (.host // "-"), .content] | @tsv' ;;
  remember)
    if [ $# -ge 2 ]; then
      host=""; [ "$1" = "-" ] || host=$(host_id "$1")
      call remember "$(jq -cn --arg h "$host" --arg c "$2" 'if $h == "" then {content:$c} else {host:$h,content:$c} end')"
    elif [ $# -eq 1 ]; then
      call remember "$(jq -cn --arg c "$1" '{content:$c}')"
    else
      usage; exit 2
    fi ;;
  forget)
    [ $# -ge 1 ] || { usage; exit 2; }
    call forget "$(jq -cn --arg i "$1" '{id:$i}')" ;;
  suppress)
    [ $# -ge 5 ] || { usage; exit 2; }
    host=$(host_id "$1"); rule=$2; why=$3; days=$4; shift 4
    conds='[]'
    for c in "$@"; do
      if [[ $c =~ ^([a-z0-9_.]+)(\$=|~=|=)(.+)$ ]]; then
        case ${BASH_REMATCH[2]} in '$=') op=endswith ;; '~=') op=contains ;; *) op=equals ;; esac
        conds=$(jq -c --arg f "${BASH_REMATCH[1]}" --arg o "$op" --arg v "${BASH_REMATCH[3]}" '. + [{field:$f,op:$o,value:$v}]' <<<"$conds")
      else
        echo "条件格式不对：$c（字段=值、字段~=值、字段\$=值）" >&2; exit 2
      fi
    done
    call suppress "$(jq -cn --arg h "$host" --arg r "$rule" --arg why "$why" --argjson d "$days" --argjson c "$conds" '{host:$h,rule_id:$r,reason:$why,days:$d,conditions:$c}')" ;;
  report)
    [ $# -ge 2 ] && [ -f "$2" ] || { usage; exit 2; }
    call report "$(jq -cn --arg t "$1" --rawfile m "$2" '{title:$t,markdown:$m}')" ;;
  *) usage; [ -z "$cmd" ] || exit 2 ;;
esac
