#!/bin/bash
# jq 的薄包装，装在 /usr/local/bin 盖住 /usr/bin/jq：模型常把 SQL 的 -> 写进过滤式（.raw->connection_info），
# jq 只报一句语法错，看不出错在哪。参数里带 -> 且 jq 报语法错时，在 stderr 末尾补一句提示；
# 标准输入输出、其余错误信息与退出码都原样不动，不带 -> 的调用直接交给真正的 jq。
REAL=/usr/bin/jq
arrow=
for a in "$@"; do
  if [[ $a == *'->'* ]]; then arrow=1; break; fi
done
[ -n "$arrow" ] || exec "$REAL" "$@"
{
  "$REAL" "$@" 2>&1 >&3 3>&- | {
    syntax=
    while IFS= read -r line || [ -n "$line" ]; do
      printf '%s\n' "$line"
      [[ $line == *'syntax error'* ]] && syntax=1
    done
    [ -z "$syntax" ] || echo 'jq 用点路径 .raw.connection_info，不是 SQL 的 ->'
  } >&2
  exit "${PIPESTATUS[0]}"
} 3>&1
