[Unit]
Description=OpenXDR HA etcd witness
After=network-online.target
Wants=network-online.target

[Service]
User=openxdr-ha
Group=openxdr-ha
ExecStart=/usr/local/bin/etcd \
  --name=openxdr-witness \
  --data-dir=/var/lib/openxdr-etcd \
  --listen-client-urls=https://0.0.0.0:2379 \
  --advertise-client-urls=https://110.42.47.158:2379 \
  --client-cert-auth=true \
  --trusted-ca-file=/opt/openxdr-ha-witness/secrets/ha-ca.crt \
  --cert-file=/opt/openxdr-ha-witness/secrets/etcd-server.crt \
  --key-file=/opt/openxdr-ha-witness/secrets/etcd-server.key \
  --auto-compaction-retention=1 \
  --auto-compaction-mode=periodic
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openxdr-etcd

[Install]
WantedBy=multi-user.target
