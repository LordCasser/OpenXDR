[Unit]
Description=OpenXDR HA NATS witness
After=network-online.target
Wants=network-online.target

[Service]
User=openxdr-ha
Group=openxdr-ha
ExecStart=/usr/local/bin/nats-server -c /opt/openxdr-ha-witness/nats.conf
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openxdr-nats

[Install]
WantedBy=multi-user.target
